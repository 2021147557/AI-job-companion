# 실제 키가 없으면 자동으로 mock 응답을 사용한다.
# 키를 발급받은 뒤 본 파일을 .env로 복사하고 값을 채워라.

PORT=3000

# 쿠키 세션 서명용 비밀키 (production 에서 반드시 변경)
SESSION_SECRET=change-me-in-production

# ── 데이터베이스 (libSQL/Turso) ─────────────────────────────────────
# 로컬 개발: file:./data/app.sqlite (기본값, 키 없이도 동작)
# Vercel 배포: Turso https URL + auth token 필요 (https://turso.tech 무료)
TURSO_DATABASE_URL=file:./data/app.sqlite
TURSO_AUTH_TOKEN=

# ── 외부 API ─────────────────────────────────────────────────────
# OpenAI (chat completions, gpt-4o-mini 권장)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Kakao Maps / Local (JavaScript 키, REST 키)
KAKAO_JS_KEY=
KAKAO_REST_KEY=

# 공공데이터포털 워크넷/고용24 채용정보 API 일반 인증키 (URL-encoded)
WORKNET_SERVICE_KEY=
