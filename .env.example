# 실제 키가 없으면 자동으로 mock 응답을 사용한다.
# 키를 발급받은 뒤 본 파일을 .env로 복사하고 값을 채워라.

PORT=3000

# 쿠키 세션 서명용 비밀키 (production 에서 반드시 변경)
SESSION_SECRET=change-me-in-production

# ── 데이터베이스 (libSQL/Turso) ─────────────────────────────────────
# 로컬 개발: file:./data/app.sqlite (기본값, 키 없이도 동작)
# Vercel 배포: Turso https URL + auth token 필요 (https://turso.tech 무료)
TURSO_DATABASE_URL=file:./data/app.sqlite
TURSO_AUTH_TOKEN=

# ── 외부 API ─────────────────────────────────────────────────────
# LLM (둘 중 하나만 채우면 됨. 둘 다 비우면 결정적 mock. 둘 다 채우면 GEMINI 우선)
# Gemini (https://aistudio.google.com/apikey, 무료 티어 충분)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (https://platform.openai.com/api-keys, 유료)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Kakao Maps / Local (JavaScript 키, REST 키)
KAKAO_JS_KEY=
KAKAO_REST_KEY=

# 고용24/워크넷 OPEN-API 채용정보 인증키(authKey)
# https://www.work24.go.kr > 고객센터 > OPEN-API > 서비스 소개 및 신청 > 채용정보
WORKNET_SERVICE_KEY=
